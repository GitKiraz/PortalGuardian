DATABASE_URL="postgresql://guardian:guardian@localhost:5432/guardian"

# LiveKit (voz, vídeo e compartilhamento de tela)
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
# URL pública do servidor LiveKit acessada pelo navegador.
# Se vazio, usa ws://<host-do-portal>:7880
LIVEKIT_URL=""

# Pasta onde os arquivos dos projetos são guardados
UPLOAD_DIR="./storage/uploads"

# URL pública do portal (links de compartilhamento, sitemap e robots.txt)
SITE_URL="http://localhost:3000"

# Cookie de sessão Secure: padrão ligado em produção. Use "false" só se servir sem HTTPS fora do localhost.
# COOKIE_SECURE="false"

# Conta Dev criada pelo seed (troque a senha após o primeiro login)
SEED_DEV_NAME="Dev Guardian"
SEED_DEV_EMAIL="dev@guardian.local"
SEED_DEV_PASSWORD="troque-esta-senha"
